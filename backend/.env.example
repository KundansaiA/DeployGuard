DB_URL=postgresql://deployguard:deployguard@localhost:5432/deployguard
SECRET_KEY=change-me-in-production

# ─────────────────────────────────────────────────────────────
# CORS — allowed frontend origins (comma-separated, no trailing slash)
#
# Local development default (already set in config.py):
#   http://localhost:5173,http://127.0.0.1:5173
#
# For production, set this to your deployed frontend URL only:
#   CORS_ORIGINS=https://deployguard.yourdomain.com
# ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─────────────────────────────────────────────────────────────
# IBM watsonx.ai — AI Explanation Layer (optional)
#
# Leave WATSONX_API_KEY and WATSONX_PROJECT_ID empty to disable
# AI explanations.  All deterministic analysis will still work.
#
# How to obtain credentials:
#   1. Log in to IBM Cloud: https://cloud.ibm.com
#   2. Create or open a watsonx.ai project
#   3. Generate an IAM API key: IAM → API Keys → Create
#   4. Copy your Project ID from the watsonx.ai project settings
#
# Required to enable explanations:
# ─────────────────────────────────────────────────────────────
WATSONX_API_KEY=
WATSONX_PROJECT_ID=

# Optional overrides (defaults shown):
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct
WATSONX_TIMEOUT_SECS=30

LOG_LEVEL=INFO
